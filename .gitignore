# Data and models (large files - NEVER commit)
data/
/models/
*.pth
*.pt
*.onnx
*.h5
*.hdf5
*.dat
*.hea

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Environment variables; only the empty template belongs in the public package.
.env*
!.env.example

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

# Claude Code local settings (keep skills tracked in git)
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Keep record-level research exports out of the public distribution.
/results/
/.pytest_cache/
/.ruff_cache/

# Logs
*.log
logs/
wandb/
mlruns/

# External repos (cloned, not committed)
external/

# Temporary
tmp/
temp/
*.tmp

# Cached backbone features — regenerable, ~140 MB per input mode
results/omi/features/
results/omi/signal_cache/
models/omi/
data/processed/omi-roundtrip/

# Mirrors of CLAUDE.md / .claude skills regenerated by another agent tool (Codex reads AGENTS.md)
AGENTS.md
.agents/
